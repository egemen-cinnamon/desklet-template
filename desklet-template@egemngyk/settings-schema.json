{
  "accentColor": {
    "type": "colorchooser",
    "default": "rgb(79,157,222)",
    "description": "Accent color"
  },
  "language": {
    "type": "combobox",
    "default": "en",
    "description": "Language",
    "tooltip": "Language of the desklet interface (week titles, buttons and dialogs)",
    "options": {
      "English": "en",
      "Turkish": "tr"
    }
  },
  "deskletTitle": {
    "type": "entry",
    "default": "",
    "description": "Desklet title",
    "tooltip": "Custom name/title shown in the top bar. Leave empty to show the week dates only."
  },
  "textColor": {
    "type": "colorchooser",
    "default": "rgb(236,238,242)",
    "description": "Text color"
  },
  "opacity": {
    "type": "scale",
    "default": 92,
    "min": 10,
    "max": 100,
    "step": 1,
    "description": "Background opacity (%)"
  },
  "layout": {
    "type": "layout",
    "pages": [
      "pageAppearance",
      "pageSize",
      "pageColors",
      "pageFrame"
    ],
    "pageAppearance": {
      "type": "page",
      "title": "Appearance",
      "sections": [
        "secAppearance",
        "secTitle"
      ]
    },
    "secAppearance": {
      "type": "section",
      "title": "Appearance",
      "keys": [
        "language",
        "compact"
      ]
    },
    "secTitle": {
      "type": "section",
      "title": "Title",
      "keys": [
        "deskletTitle"
      ]
    },
    "pageSize": {
      "type": "page",
      "title": "Size",
      "sections": [
        "secSize"
      ]
    },
    "secSize": {
      "type": "section",
      "title": "Size",
      "keys": [
        "width",
        "height",
        "fontSize",
        "uiScale"
      ]
    },
    "pageColors": {
      "type": "page",
      "title": "Colors",
      "sections": [
        "secColors"
      ]
    },
    "secColors": {
      "type": "section",
      "title": "Colors",
      "keys": [
        "bgColor",
        "textColor",
        "accentColor",
        "borderColor"
      ]
    },
    "pageFrame": {
      "type": "page",
      "title": "Frame",
      "sections": [
        "secFrame"
      ]
    },
    "secFrame": {
      "type": "section",
      "title": "Frame and transparency",
      "keys": [
        "opacity",
        "borderWidth",
        "borderRadius"
      ]
    }
  },
  "uiScale": {
    "type": "combobox",
    "default": 100,
    "description": "UI scale",
    "options": {
      "%75": 75,
      "%90": 90,
      "%100": 100,
      "%110": 110,
      "%125": 125,
      "%150": 150,
      "%175": 175,
      "%200": 200
    }
  },
  "borderWidth": {
    "type": "spinbutton",
    "default": 1,
    "min": 0,
    "max": 8,
    "step": 1,
    "units": "px",
    "description": "Border width"
  },
  "bgColor": {
    "type": "colorchooser",
    "default": "rgb(28,30,36)",
    "description": "Background color"
  },
  "fontSize": {
    "type": "spinbutton",
    "default": 12,
    "min": 8,
    "max": 28,
    "step": 1,
    "units": "px",
    "description": "Font size"
  },
  "width": {
    "type": "spinbutton",
    "default": 620,
    "min": 240,
    "max": 2400,
    "step": 10,
    "units": "px",
    "description": "Width"
  },
  "height": {
    "type": "spinbutton",
    "default": 420,
    "min": 160,
    "max": 1600,
    "step": 10,
    "units": "px",
    "description": "Height"
  },
  "borderColor": {
    "type": "colorchooser",
    "default": "rgb(70,76,90)",
    "description": "Border color"
  },
  "compact": {
    "type": "switch",
    "default": false,
    "description": "Compact view"
  },
  "borderRadius": {
    "type": "spinbutton",
    "default": 10,
    "min": 0,
    "max": 40,
    "step": 1,
    "units": "px",
    "description": "Corner radius"
  }
}